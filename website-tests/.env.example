# Private authenticated test settings. Copy to .env; never commit the populated file.
# Also copy config.example.json to .env.authenticated.json.
WBTEST_CONFIG=.env.authenticated.json
WBTEST_TARGET=fixtures
WBTEST_SITES=
WBTEST_SCENARIOS=
WBTEST_LIVE_MUTATIONS=false
WBTEST_ALLOWED_ACTIONS=
WBTEST_ARTIFACTS=artifacts
WBTEST_MAX_RUNS=90
WBTEST_TIMEOUT_MS=180000
WBTEST_REPETITIONS=1

# A performs the task. Choose local or cloud explicitly.
WBTEST_ACTOR_BACKEND=local
WBTEST_ACTOR_PROFILE=
WBTEST_ACTOR_CDP_URL=
WBTEST_ACTOR_EXECUTABLE=
WBTEST_ACTOR_EXTENSION_PATH=
WBTEST_ACTOR_EXTENSION_ID=
WBTEST_ACTOR_HEADLESS=false
WBTEST_ACTOR_PROVIDER=
WBTEST_ACTOR_MODEL=
WBTEST_ACTOR_EXPECTED_VERSION=
# Local build pin means the reported four-file runtime SHA-256, not a Git SHA.
WBTEST_ACTOR_EXPECTED_BUILD=
WEBBRAIN_BASE_URL=https://webbrain.cloud
WEBBRAIN_API_KEY=
WBTEST_ACTOR_SESSION_ID=

# B receives/verifies independently. A local observer needs no WebBrain/provider.
WBTEST_OBSERVER_BACKEND=local
WBTEST_OBSERVER_PROFILE=
WBTEST_OBSERVER_CDP_URL=
WBTEST_OBSERVER_EXECUTABLE=
WBTEST_OBSERVER_HEADLESS=false
WEBBRAIN_OBSERVER_BASE_URL=https://webbrain.cloud
WEBBRAIN_OBSERVER_API_KEY=
WBTEST_OBSERVER_SESSION_ID=
